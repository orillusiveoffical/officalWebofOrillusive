{
  "name": "orillusive-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix client\" \"npm run dev --prefix server\"",
    "build": "npm run build --prefix client",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "db:migrate": "npm run migrate --prefix server",
    "install:all": "npm install --prefix client && npm install --prefix server"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@vercel/node": "^5.9.5",
    "concurrently": "^8.2.2",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.1",
    "resend": "^6.18.1"
  }
}
